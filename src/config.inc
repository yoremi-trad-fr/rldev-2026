# Automatically generated by configure

ENABLE_WIN32=true
ENABLE_HEVEA=false
ENABLE_PDFLATEX=false
ENABLE_RLXML=true
ENABLE_VACONV=true
FORCE_XMLLIGHT=true
PNG_CFLAGS = -I/usr/include
PNG_LDFLAGS = -lpng -lz

.PHONY: install uninstall
install:
  ./install-sh -d /usr/local/bin
  foreach(f, $(addprefix $(EXEDIR)/,kprl$(EXE) rlc$(EXE) rlxml$(EXE)))
    ./install-sh -t /usr/local/bin $(f)
  ./install-sh -d /usr/local/share/rldev/lib
  foreach(f, $(glob ../lib/*))
    ./install-sh -m 644 -t /usr/local/share/rldev/lib $(f)
  ./install-sh -d /usr/local/share/rldev/rtl
  foreach(f, $(glob ../rtl/*))
    ./install-sh -m 644 -t /usr/local/share/rldev/rtl $(f)

uninstall:
  $(RM) $(addprefix /usr/local/bin/,kprl$(EXE) rlc$(EXE) rlxml$(EXE))
  $(RM) -r /usr/local/share/rldev
